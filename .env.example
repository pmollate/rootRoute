# Copy to .env (never commit .env). See docs/CONTRACTS.md §7.
DATABASE_URL=postgres://latelens:latelens@localhost:5432/latelens
TEST_DATABASE_URL=postgres://latelens:latelens@localhost:5432/latelens_test
PORT=3001

# AI model: azure-openai | recorded (recorded replays backend/api/test/recordings, no key needed)
LLM_PROVIDER=recorded
# Azure AI Foundry: v1 endpoint (must end /openai/v1/), key (only in .env, never here), deployment name
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# PII removal before the AI model: azure-language | recorded
PII_PROVIDER=recorded
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
# Address check on the map: azure-maps | recorded. Key from the Azure Maps account (Authentication tab)
ADDRESS_PROVIDER=recorded
AZURE_MAPS_KEY=
RECORD=

# Gmail demo inbox (a dedicated account, never a personal inbox). Refresh token from: npm --prefix backend/api run gmail:auth
GMAIL_ACCOUNT=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Shared demo key for write endpoints, and who replies may be sent to
API_KEY=dev-key
ALLOW_LIST=ops-test@latelens.example,orders@client190.example

# Dashboard in frontend/ (next.config.mjs loads this file; the demo key is visible in the browser: synthetic data only)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_KEY=dev-key
# true serves the maintenance page (503) on every frontend route; restart `npm run dev` after changing
MAINTENANCE_MODE=false

AZURE_MAPS_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=