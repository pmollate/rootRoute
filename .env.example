# Copy to .env (never commit .env). See docs/CONTRACTS.md §7.
DATABASE_URL=postgres://latelens:latelens@localhost:5432/latelens
TEST_DATABASE_URL=postgres://latelens:latelens@localhost:5432/latelens_test
PORT=3001

# AI model: azure-openai | recorded (recorded replays backend/api/test/recordings, no key needed)
LLM_PROVIDER=recorded
# Azure AI Foundry: v1 endpoint (must end /openai/v1/), key (only in .env, never here), deployment name
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# PII removal before the AI model: azure-language | recorded
PII_PROVIDER=recorded
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
# Address check on the map: azure-maps | recorded. Key from the Azure Maps account (Authentication tab)
ADDRESS_PROVIDER=recorded
AZURE_MAPS_KEY=
RECORD=

# Gmail demo inbox (a dedicated account, never a personal inbox). Refresh token from: npm --prefix backend/api run gmail:auth
GMAIL_ACCOUNT=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# How often the API checks the inbox for new order emails, in minutes (E15). 0 turns the check off.
INTAKE_POLL_MINUTES=10

# Shared demo key for write endpoints, and who replies may be sent to
API_KEY=dev-key
# Ask LateLens MCP endpoint (D7): Bearer token, at least 16 characters; leave empty to keep /api/mcp off
MCP_TOKEN=
ALLOW_LIST=ops-test@latelens.example,orders@client190.example

# Dashboard in frontend/ (next.config.mjs loads this file). The browser calls /api on its own origin; the server-side
# proxy reaches the API at API_URL (below) and, with AUTH_REQUIRED=off and nobody signed in, adds API_KEY itself.
# true serves the maintenance page (503) on every frontend route; restart `npm run dev` after changing
MAINTENANCE_MODE=false

# Sign-in and roles (P7, docs/SPEC-auth.md §9.2). `npm run setup` fills the local values (demo accounts, secrets).
# off (default): no sign-in needed, x-api-key as before; on: every page and API call needs a signed-in user
AUTH_REQUIRED=off
# The web app's public URL; also the only Origin the /api proxy accepts for writes
AUTH_URL=
# Secrets: never here. AUTH_SECRET encrypts the session cookie; INTERNAL_AUTH_SECRET (32+ bytes) signs web -> API calls
AUTH_SECRET=
INTERNAL_AUTH_SECRET=
# Microsoft Entra ID app registration rootroute01-web (single tenant); leave empty to show only demo sign-in
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# on: demo accounts demo-<role>@rootroute.test; AUTH_DEMO_USERS is JSON with bcrypt hashes, written by npm run setup
AUTH_DEMO=on
AUTH_DEMO_USERS=
# Fastify API base URL for the web app's /api proxy (server side only; never NEXT_PUBLIC_)
API_URL=http://localhost:3001

AZURE_MAPS_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=