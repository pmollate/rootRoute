# Test defaults (vitest sets NODE_ENV=test, which selects this file; or set APP_ENV=test). Non-secret settings only.
# Precedence: real environment variables > this file > root .env, so a local .env cannot switch tests to live services.
APP_ENV=test
TEST_DATABASE_URL=postgres://latelens:latelens@localhost:5432/latelens_test
LLM_PROVIDER=recorded
PII_PROVIDER=recorded
ADDRESS_PROVIDER=recorded
# No inbox polling during tests
INTAKE_POLL_MINUTES=0
ALLOW_LIST=ops-test@latelens.example,orders@client190.example
AUTH_REQUIRED=off
ASK_ASSISTANT=off
CONFIRM_LINK=off
MAINTENANCE_MODE=false
