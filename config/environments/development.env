# Development (local machine) defaults. Non-secret settings only: secrets live in the root .env (gitignored).
# Precedence: real environment variables > root .env > this file. APP_ENV picks the file (docs/ARCHITECTURE.md §4).
APP_ENV=development
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
DATABASE_URL=postgres://latelens:latelens@localhost:5432/latelens
TEST_DATABASE_URL=postgres://latelens:latelens@localhost:5432/latelens_test
# Recorded AI, PII and map answers: runs with no keys; set azure-* in .env to read new emails
LLM_PROVIDER=recorded
PII_PROVIDER=recorded
ADDRESS_PROVIDER=recorded
INTAKE_POLL_MINUTES=10
ALLOW_LIST=ops-test@latelens.example,orders@client190.example
AUTH_REQUIRED=off
AUTH_DEMO=on
ASK_ASSISTANT=off
CONFIRM_LINK=off
MAINTENANCE_MODE=false
