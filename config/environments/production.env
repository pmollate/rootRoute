# Production (Azure App Service, rootroute01-*) defaults, shipped with the API and web packages by CD.
# Non-secret settings only. Secrets are App Service app settings, which always win over this file: DATABASE_URL,
# API_KEY, MCP_TOKEN and AUTH_* are Key Vault references (infra/setup.sh, infra/setup-auth.sh); the Azure AI, Maps and
# Gmail secrets come from the GitHub environment "copilot", copied in by cd.yml on every deploy (docs/SECURITY.md §2).
# Feature flags (AUTH_REQUIRED, ASK_ASSISTANT, CONFIRM_LINK) are set per app on App Service, not here.
APP_ENV=production
NODE_ENV=production
LLM_PROVIDER=azure-openai
INTAKE_POLL_MINUTES=10
ALLOW_LIST=ops-test@latelens.example,orders@client190.example
AUTH_DEMO=on
AUTH_TRUST_HOST=true
MAINTENANCE_MODE=false
NEXT_TELEMETRY_DISABLED=1
