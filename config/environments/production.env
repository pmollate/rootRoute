# Production (Azure App Service, rootroute01-*) defaults, shipped with the API and web packages by CD.
# Non-secret settings only. Secrets (DATABASE_URL, API_KEY, AUTH_*, Azure keys) are Key Vault references set as App
# Service app settings by infra/setup.sh, infra/setup-auth.sh and cd.yml; app settings always win over this file.
# Feature flags (AUTH_REQUIRED, ASK_ASSISTANT, CONFIRM_LINK) are set per app on App Service, not here.
APP_ENV=production
NODE_ENV=production
LLM_PROVIDER=azure-openai
INTAKE_POLL_MINUTES=10
ALLOW_LIST=ops-test@latelens.example,orders@client190.example
AUTH_DEMO=on
AUTH_TRUST_HOST=true
MAINTENANCE_MODE=false
NEXT_TELEMETRY_DISABLED=1
