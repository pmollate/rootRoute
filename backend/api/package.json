{
  "name": "@latelens/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/core/db/migrate-cli.ts",
    "migrate:test": "tsx src/core/db/migrate-cli.ts --test",
    "seed": "tsx src/modules/intake/seed.ts",
    "gmail:auth": "tsx scripts/gmail-auth.ts",
    "gmail:seed": "tsx scripts/gmail-seed.ts",
    "gmail:fetch": "tsx scripts/gmail-fetch.ts",
    "maps:check": "tsx scripts/maps-check.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "openai": "^7.45.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
